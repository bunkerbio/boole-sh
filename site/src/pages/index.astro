		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.demo-bar {
		display: grid;
		grid-template-columns: 120px 1fr 80px;
		align-items: center;
		gap: 1rem;
	}

	.bar-label {
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.bar-fill {
		height: 28px;
		border-radius: 4px;
		transition: width 1s ease;
	}

	.original .bar-fill {
		background: #3a3a42;
	}

	.zstd .bar-fill {
		background: #5a5a64;
	}

	.boole .bar-fill {
