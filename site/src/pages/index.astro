		font-family: var(--mono);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}

	.claim-label {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	section.how,
	section.benchmarks,
	section.architecture,
	section.why {
		padding: 5rem 0;
	}

	h2 {
		font-size: 2rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.section-intro {
		font-size: 1.1rem;
		color: var(--text-muted);
		max-width: 680px;
		margin-bottom: 3rem;
		line-height: 1.7;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.feature {
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
