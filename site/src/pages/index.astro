	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 3rem;
			min-height: auto;
			padding-top: 6rem;
		}

		.claims {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.features {
